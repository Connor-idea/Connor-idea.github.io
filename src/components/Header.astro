---
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search';

const nav = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '博客' },
  { href: '/tags', label: '标签' },
  { href: '/about', label: '关于' },
];

const current = Astro.url.pathname;
---

<header class="border-b border-ink/10 sticky top-0 z-40 bg-paper/80 backdrop-blur">
  <div class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="font-bold text-lg tracking-tight hover:text-accent transition-colors">
      My Blog
    </a>
    <nav class="flex items-center gap-6">
      {
        nav.map((item) => {
          const active =
            item.href === '/'
              ? current === '/'
              : current.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'text-sm transition-colors',
                active ? 'text-accent font-medium' : 'text-ink/70 hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
      <Search client:idle />
      <ThemeToggle />
    </nav>
  </div>
</header>
