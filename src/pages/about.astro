---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const profile = {
  name: SITE.author,
  title: '软件工程师 / 终身学习者',
  location: '中国',
  email: 'hello@connor.zone',
  bio: '一名热爱构建的软件工程师，关注 Web 技术、产品设计与工程效率。这个博客是我的公开笔记本：记录技术实践、阅读思考与生活碎片，也希望通过写作把模糊的直觉整理成清晰的判断。相信好的工具应该服务于内容，好的表达应该经得起时间。',
  skills: ['TypeScript', 'React', 'Astro', 'Node.js', 'Three.js', '设计系统'],
  links: [
    { label: 'GitHub', href: 'https://github.com/Connor-idea' },
    { label: 'RSS', href: '/rss.xml' },
  ],
};
---

<BaseLayout title="关于 | My Blog" description={`关于 ${profile.name}`}>
  <header class="mb-14">
    <h1 class="text-3xl font-semibold tracking-wide">关于</h1>
    <p class="mt-3 text-ink/55 tracking-wide">一些关于我的信息</p>
  </header>

  <!-- 纵向留白分组，替代边框卡片 -->
  <section class="space-y-14">
    <div class="flex flex-col items-start gap-8 sm:flex-row sm:items-center">
      <div
        class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-accent/10 text-2xl font-medium text-accent"
      >
        {profile.name.slice(0, 1)}
      </div>
      <div>
        <h2 class="text-2xl font-semibold tracking-wide">{profile.name}</h2>
        <p class="mt-1.5 text-ink/60 tracking-wide">{profile.title}</p>
        <p class="mt-1 text-sm text-ink/45 tracking-wide">{profile.location}</p>
      </div>
    </div>

    <div>
      <h3 class="text-xs font-medium uppercase tracking-[0.25em] text-ink/50">简介</h3>
      <p class="mt-4 text-ink/75 leading-loose max-w-2xl">{profile.bio}</p>
    </div>

    <div>
      <h3 class="text-xs font-medium uppercase tracking-[0.25em] text-ink/50">技能</h3>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        {
          profile.skills.map((skill) => (
            <li class="text-ink/70 tracking-wide">{skill}</li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-medium uppercase tracking-[0.25em] text-ink/50">链接</h3>
      <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-2">
        {
          profile.links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-accent/85 hover:text-accent transition-colors tracking-wide"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-medium uppercase tracking-[0.25em] text-ink/50">联系</h3>
      <p class="mt-4 text-ink/75">
        <a href={`mailto:${profile.email}`} class="text-accent/85 hover:text-accent transition-colors tracking-wide">
          {profile.email}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
