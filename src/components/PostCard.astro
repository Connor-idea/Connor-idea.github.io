---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<li class="group">
  <!-- 无卡片边框：纯排版 + 留白形成条目节奏 -->
  <a href={`/blog/${post.id}`} class="block py-8">
    <div class="flex items-baseline gap-4 text-sm text-ink/45">
      <time datetime={pubDate.toISOString()} class="tabular-nums tracking-wide">
        {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-x-3 gap-y-1">
            {tags.map((tag) => (
              <span class="text-accent/70 tracking-wide">{tag}</span>
            ))}
          </div>
        )
      }
    </div>
    <h3 class="mt-3 text-2xl font-semibold leading-snug tracking-wide transition-colors group-hover:text-accent">
      {title}
    </h3>
    <p class="mt-3 text-ink/60 leading-loose max-w-2xl">{description}</p>
  </a>
</li>
