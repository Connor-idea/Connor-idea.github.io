---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { PAGE_SIZE } from '../../consts';

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return paginate(posts, { pageSize: PAGE_SIZE });
}

const { page } = Astro.props;
const { currentPage, total } = page;
---

<BaseLayout
  title={currentPage === 1 ? '博客 | My Blog' : `博客 · 第 ${currentPage} 页 | My Blog`}
  description="全部文章列表"
>
  <header class="mb-4">
    <h1 class="text-3xl font-semibold tracking-wide">博客</h1>
    <p class="mt-3 text-ink/45 tracking-wide">共 {total} 篇文章</p>
  </header>

  {
    page.data.length > 0 ? (
      <ul class="mt-4">
        {page.data.map((post) => (
          <PostCard post={post} />
        ))}
      </ul>
    ) : (
      <p class="mt-12 text-ink/45">还没有文章，敬请期待。</p>
    )
  }

  <Pagination page={page} basePath="/blog" />
</BaseLayout>
