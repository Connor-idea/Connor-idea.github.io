---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const profile = {
  name: SITE.author,
  title: '软件工程师 / 终身学习者',
  location: '中国 · 某城市',
  email: 'your-email@example.com',
  bio: '这里是一段简短的自我介绍占位文字。你可以介绍自己的职业方向、兴趣爱好，以及写博客的初衷。',
  skills: ['TypeScript', 'React', 'Astro', 'Node.js', 'Three.js'],
  links: [
    { label: 'GitHub', href: 'https://github.com/your-username' },
    { label: 'X / Twitter', href: 'https://x.com/your-username' },
    { label: '掘金', href: 'https://juejin.cn/user/your-username' },
  ],
};
---

<BaseLayout title="关于 | My Blog" description={`关于 ${profile.name}`}>
  <header class="mb-14">
    <h1 class="text-3xl font-semibold tracking-wide">关于</h1>
    <p class="mt-3 text-ink/45 tracking-wide">一些关于我的信息</p>
  </header>

  <!-- 纵向留白分组，替代边框卡片 -->
  <section class="space-y-14">
    <div class="flex flex-col items-start gap-8 sm:flex-row sm:items-center">
      <div
        class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-accent/10 text-2xl font-medium text-accent"
      >
        {profile.name.slice(0, 1)}
      </div>
      <div>
        <h2 class="text-2xl font-semibold tracking-wide">{profile.name}</h2>
        <p class="mt-1.5 text-ink/55 tracking-wide">{profile.title}</p>
        <p class="mt-1 text-sm text-ink/35 tracking-wide">{profile.location}</p>
      </div>
    </div>

    <div>
      <h3 class="text-xs font-medium uppercase tracking-[0.25em] text-ink/40">简介</h3>
      <p class="mt-4 text-ink/70 leading-loose max-w-2xl">{profile.bio}</p>
    </div>

    <div>
      <h3 class="text-xs font-medium uppercase tracking-[0.25em] text-ink/40">技能</h3>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        {
          profile.skills.map((skill) => (
            <li class="text-ink/65 tracking-wide">{skill}</li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-medium uppercase tracking-[0.25em] text-ink/40">链接</h3>
      <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-2">
        {
          profile.links.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent/80 hover:text-accent transition-colors tracking-wide"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-medium uppercase tracking-[0.25em] text-ink/40">联系</h3>
      <p class="mt-4 text-ink/70">
        <a href={`mailto:${profile.email}`} class="text-accent/80 hover:text-accent transition-colors tracking-wide">
          {profile.email}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
