---
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search';
import { SITE } from '../consts';

const nav = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '博客' },
  { href: '/tags', label: '标签' },
  { href: '/about', label: '关于' },
];

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-paper/85 backdrop-blur-md">
  <!-- 无边框：靠留白与背景轻透区隔 -->
  <div class="max-w-3xl mx-auto px-6 sm:px-8 h-20 flex items-center justify-between">
    <a href="/" class="text-lg font-semibold tracking-wide hover:text-accent transition-colors">
      {SITE.title}
    </a>
    <nav class="flex items-center gap-7">
      {
        nav.map((item) => {
          const active =
            item.href === '/'
              ? current === '/'
              : current.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'text-sm tracking-wide transition-colors',
                active ? 'text-accent' : 'text-ink/55 hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
      <Search client:idle />
      <ThemeToggle />
    </nav>
  </div>
</header>
